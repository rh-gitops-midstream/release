{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "main",
    "release-1.22",
    "release-1.21",
    "release-1.20"
  ],
  "ignoreDeps": [
    "registry.redhat.io/rhel9/go-toolset",
    "registry.redhat.io/rhel8/go-toolset",
    "registry.redhat.io/openshift-gitops-1/argocd-agent-rhel8",
    "registry.redhat.io/openshift-gitops-1/argocd-agent-rhel9"
  ],
  "ignorePaths": [
    "containers/argocd/ui/**",
    "clis/kubectl-argo-rollouts/ui/**",
    "prefetch/pnpm/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "git-submodules",
        "github-actions"
      ],
      "enabled": false
    }
  ]
}
